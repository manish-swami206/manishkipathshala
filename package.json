  "scripts": {
    "dev": "pnpm --parallel --filter api-server --filter exam-platform dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./src/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:backup": "node backups/backup.js",
    "db:backup:stdout": "node backups/backup.js --stdout",
    "db:restore": "node backups/restore.js"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  }
}
